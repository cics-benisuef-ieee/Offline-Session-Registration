# Copy to .env for local development. Never commit .env.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app
CSRF_TRUSTED_ORIGINS=http://localhost:8000,https://*.vercel.app

# Local default. For Supabase, use the pooled Supavisor URL at runtime:
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres?sslmode=require
# Use the direct database host/port for migrations:
# DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require
DATABASE_URL=sqlite:///db.sqlite3

# PostgreSQL SSL mode for production/Vercel; defaults to require.
# DB_SSLMODE=require

# Outgoing email is disabled in the application (dummy backend). Notifications
# are delivered in-app and through browser Web Push. No SMTP settings are used.

# Browser Web Push (VAPID). Generate a pair with:
#   uv run python manage.py generate_vapid_keys
# Leave both keys empty to keep in-app notifications but disable browser push.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:sessions@example.com

# Bearer secret for scheduler-triggered endpoints (/cron/reminders/ and
# /cron/digest/). Leave empty locally; set the same value in Vercel and the
# GitHub Actions CRON_SECRET repository secret in production.
# CRON_SECRET=replace-with-a-long-random-secret

# Keep these false for local HTTP. Set true on HTTPS deployments.
DJANGO_SECURE_COOKIES=False
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
